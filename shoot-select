# Toolbar: (tool, icon, tooltip). Colors follow, then undo. Adwaita has no
# arrow or hollow rectangle icon, so those two draw their own.
TOOLS = (('select', 'view-fullscreen-symbolic', 'Adjust selection  V'),
         ('box', 'media-playback-stop-symbolic', 'Box  R  ·  Ctrl from center'),
         ('outline', None, 'Outline  O  ·  Ctrl from center  ·  Q W or scroll to size'),
         ('brush', 'document-edit-symbolic', 'Brush  B  ·  Q W or scroll to size'),
         ('arrow', None, 'Arrow  A  ·  Drag tail to tip  ·  Shift snaps  ·  Q W or scroll to size'),
         ('pick', 'color-select-symbolic', 'Pick a color from the screen  I'))
ICONS = {tool: icon for tool, icon, _ in TOOLS}
TOOL_KEYS = {Gdk.KEY_v: 'select', Gdk.KEY_r: 'box', Gdk.KEY_o: 'outline', Gdk.KEY_b: 'brush', Gdk.KEY_i: 'pick',
             Gdk.KEY_a: 'arrow'}
DRAW_TOOLS = ('box', 'outline', 'brush', 'arrow')
SIZED_TOOLS = ('outline', 'brush', 'arrow')  # Q, W, and the scroll wheel change their line width.
# Q and W sit under the left hand, which also has the tool keys; [ ] still work.
SIZE_KEYS = {Gdk.KEY_q: 1 / 1.25, Gdk.KEY_w: 1.25, Gdk.KEY_bracketleft: 1 / 1.25, Gdk.KEY_bracketright: 1.25}
COLORS = ((0, 0, 0), (1, 1, 1), (.86, .2, .2))  # The picked color is the fourth swatch.
RED = 2
# Each tool's color until the user chooses one: arrows and outlines point things out, boxes hide them.
DEFAULT_COLORS = {'box': 0, 'outline': RED, 'brush': 0, 'arrow': RED}
COLOR_NAMES = ('Black', 'White', 'Red', 'Picked color')
BUTTON, GAP, PADDING, SEPARATOR = 32, 2, 5, 10
UPSCALE_STEPS = {1: 2, 2: 4, 4: 1}
SEARCH_DELAY = 250  # Milliseconds without selection changes before looking for the PDF.
SEARCH_WAIT = 35  # Seconds Enter waits for a running PDF search before saving at 1×.
UPSCALE = Path(__file__).resolve().with_name('upscale.py')
BRUSH_SIZES = (2, 400)

CURSORS = {
    None: 'crosshair', 'move': 'move',
    'n': 'ns-resize', 's': 'ns-resize', 'e': 'ew-resize', 'w': 'ew-resize',
    'nw': 'nwse-resize', 'se': 'nwse-resize', 'ne': 'nesw-resize', 'sw': 'nesw-resize',
}


def rect(x, y, w, h):
    return Graphene.Rect().init(x, y, w, h)


def push_rounded(snapshot, bounds, radius):
    # Keep the struct in a variable: chaining init_from_rect onto a temporary
    # returns a view of memory PyGObject frees before GTK reads it.
    clip = Gsk.RoundedRect()
    clip.init_from_rect(bounds, radius)
    snapshot.push_rounded_clip(clip)


def rgba(color):
    return Gdk.RGBA(red=color[0], green=color[1], blue=color[2], alpha=1)


def stroke_path(points):
    builder = Gsk.PathBuilder.new()
    (x, y), *rest = points
    builder.move_to(x, y)
    for x, y in rest or [(x + .01, y)]:  # A single click still leaves a dot.
        builder.line_to(x, y)
    return builder.to_path()


def round_stroke(width):
    stroke = Gsk.Stroke.new(width)
    stroke.set_line_cap(Gsk.LineCap.ROUND)
    stroke.set_line_join(Gsk.LineJoin.ROUND)
    return stroke


def append_outline(snapshot, outline, color):
    path = outline.path
    builder = Gsk.PathBuilder.new()
    builder.add_rect(rect(path.x, path.y, path.w, path.h))
    stroke = Gsk.Stroke.new(outline.width)
    stroke.set_line_join(Gsk.LineJoin.MITER)
    snapshot.append_stroke(builder.to_path(), stroke, color)


def append_arrow(snapshot, shape, width, color):
    if not shape:
        return
    shaft, head = shape
    snapshot.append_stroke(stroke_path(shaft), round_stroke(width), color)
    builder = Gsk.PathBuilder.new()
    builder.move_to(*head[0])
    for x, y in head[1:]:
        builder.line_to(x, y)
    builder.close()
    snapshot.append_fill(builder.to_path(), Gsk.FillRule.WINDING, color)


def capture(monitors):
    """Grab every output at once, before any overlay is visible."""
    def grab(monitor):
        result = subprocess.run(['grim', '-l', '0', '-o', monitor.get_connector(), '-'],
                                capture_output=True, env=CHILD_ENVIRONMENT, timeout=10, check=False)
        if result.returncode:
            raise RuntimeError(f'grim failed on {monitor.get_connector()}: '
                               f'{result.stderr.decode(errors="replace").strip()}')
        loader = GdkPixbuf.PixbufLoader.new_with_type('png')
        loader.write(result.stdout)
        loader.close()
        return loader.get_pixbuf()
    with ThreadPoolExecutor(len(monitors)) as pool:
        return list(pool.map(grab, monitors))


def texture_for(pixbuf):
    memory_format = Gdk.MemoryFormat.R8G8B8A8 if pixbuf.get_has_alpha() else Gdk.MemoryFormat.R8G8B8
    return Gdk.MemoryTexture.new(pixbuf.get_width(), pixbuf.get_height(), memory_format,
                                 pixbuf.read_pixel_bytes(), pixbuf.get_rowstride())


class Session:
    def __init__(self, outputs, pixbufs, initial):
        self.outputs, self.pixbufs = outputs, pixbufs
        self.bounds = outputs[0].rect
        for output in outputs[1:]:
            self.bounds = self.bounds.union(output.rect)
        self.selection = initial
        # zone, selection when the drag began, start point, latest offsets.
        self.dragging = None
        self.pointer = None  # Global logical point.
        self.pointer_output = outputs[0]
        self.tool, self.draw_tool = 'select', 'box'
        self.color_index, self.picked = 0, (.5, .5, .5)
        self.color_chosen = False  # A swatch or Pick then applies to every tool.
        self.widths = {'outline': 4, 'brush': 16, 'arrow': 4}
        self.annotations, self.current = [], None
        self.canvases, self.windows = [], []
        self.icons = {}
        self.upscale = 1
        self.remove_white = False
        # The PDF search for one selection: selection, process, done, result.
        self.search = None
        self.search_timer, self.search_pending = None, None
        self.waiting = False  # Enter was pressed; the loop ends when the search does.
        self.action = None
        self.loop = GLib.MainLoop()

    @property
    def color(self):
        return (*COLORS, self.picked)[self.color_index]

    def set_tool(self, tool):
        self.tool = tool
        if tool in DRAW_TOOLS:
            self.draw_tool = tool
            if not self.color_chosen:
                self.color_index = DEFAULT_COLORS[tool]
        self.redraw()

    def drawing(self):
        """Whether a drag should paint instead of changing the selection."""
        return self.selection and self.tool in DRAW_TOOLS

    def pixel_at(self, x, y):
        for output in self.outputs:
            if output.rect.contains(x, y):
                pixel_x = min(int((x - output.rect.x) * output.scale), output.pixel_w - 1)
                pixel_y = min(int((y - output.rect.y) * output.pixel_h / output.rect.h), output.pixel_h - 1)
                data = self.pixbufs[output.name].new_subpixbuf(pixel_x, pixel_y, 1, 1).copy().get_pixels()
                return tuple(channel / 255 for channel in data[:3])
        return None

    def pick(self, x, y):
        color = self.pixel_at(x, y)
        if color:
            self.picked, self.color_index = color, len(COLORS)
            self.color_chosen = True
            self.set_tool(self.draw_tool)

    def undo(self):
        if self.annotations:
            self.annotations.pop()
            self.redraw()

    def toolbar(self):
        """Toolbar items with their global rectangles, or nothing without a selection."""
        if not self.selection:
            return []
        layout = [('tool', name) for name, _, _ in TOOLS] + [None]
        layout += [('color', index) for index in range(len(COLORS) + 1)] + [None, ('undo',), None, ('upscale',)]
        layout += [('remove-white',)]
        width = 2 * PADDING + sum(SEPARATOR if item is None else BUTTON + GAP for item in layout) - GAP
        box = place_toolbar(self.selection, self.outputs, width, BUTTON + 2 * PADDING)
        items, x = [(('toolbar',), box)], box.x + PADDING
        for item in layout:
            if item is None:
                x += SEPARATOR
            else:
                items.append((item, Rect(x, box.y + PADDING, BUTTON, BUTTON)))
                x += BUTTON + GAP
        return items

    def toolbar_item_at(self, x, y):
        """The toolbar entry under a point; the toolbar background counts too."""
        hit = None
        for item, area in self.toolbar():
            if area.contains(x, y):
                hit = item
        return hit

    def activate(self, item):
        if item[0] == 'tool':
            self.set_tool(item[1])
        elif item[0] == 'color':
            self.color_index, self.color_chosen = item[1], True
            if self.tool not in DRAW_TOOLS:
                self.set_tool(self.draw_tool)
            self.redraw()
        elif item[0] == 'undo':
            self.undo()
        elif item[0] == 'upscale':
            self.upscale = UPSCALE_STEPS[self.upscale]
            self.redraw()
        elif item[0] == 'remove-white':
            self.remove_white = not self.remove_white
            self.redraw()

    def begin_drag(self, x, y):
        item = self.toolbar_item_at(x, y)
        if item:
            self.activate(item)
            zone = 'ignore'
        elif self.tool == 'pick':
            self.pick(x, y)
            zone = 'ignore'
        elif self.drawing():
            zone = self.tool
        else:
            zone = hit_test(self.selection, x, y) or 'new'
        self.dragging = dict(zone=zone, start=self.selection, x=x, y=y, dx=0, dy=0)
        if zone == 'brush':
            self.current = Stroke([(x, y)], self.widths['brush'], self.color)
            self.redraw()

    def update_drag(self, dx, dy, centered, snap=False):
        """centered comes from Ctrl and resizes around the center; snap comes
        from Shift and turns an arrow to the nearest 45 degrees."""
        drag_state = self.dragging
        drag_state.update(dx=dx, dy=dy)
        zone, x, y = drag_state['zone'], drag_state['x'], drag_state['y']
        if zone in ('new', 'box', 'outline'):
            area = (centered_span(x, y, abs(dx), abs(dy), self.bounds) if centered
                    else span_within(x, y, x + dx, y + dy, self.bounds))
            if zone == 'new':
                self.selection = area
            elif zone == 'box':
                self.current = Box(area, self.color)
            else:
                self.current = Outline(area, self.widths['outline'], self.color)
        elif zone == 'arrow':
            if snap:
                dx, dy = snap_angle(dx, dy)
            self.current = Arrow((x, y), (x + dx, y + dy), self.widths['arrow'], self.color)
        elif zone == 'brush':
            self.current.points.append((x + dx, y + dy))
        elif zone != 'ignore':
            self.selection = drag(zone, drag_state['start'], dx, dy, self.bounds, centered)
        self.redraw()

    def end_drag(self):
        zone, start = self.dragging['zone'], self.dragging['start']
        self.dragging = None
        selection = self.selection
        if zone == 'new' and (selection is None or min(selection.w, selection.h) < MIN_NEW_SIZE):
            self.selection = start
        elif zone in ('box', 'outline') and self.current and self.current.rect.w and self.current.rect.h:
            self.annotations.append(self.current)
        elif zone == 'arrow' and self.current and self.current.shape:
            self.annotations.append(self.current)
        elif zone == 'brush' and self.current:
            self.annotations.append(Stroke(tuple(self.current.points), self.current.width, self.current.color))
        self.current = None
        self.redraw()

    def resize_stroke(self, factor):
        tool = self.tool if self.tool in SIZED_TOOLS else 'brush'
        size = self.widths[tool]
        # A wheel tick must change thin lines too, even when rounding would not.
        step = max(1, round(size * abs(factor - 1)))
        self.widths[tool] = clamp(size + (step if factor > 1 else -step), *BRUSH_SIZES)
        self.redraw()

    def adjusting(self):
        """Whether the selection itself is being dragged; the toolbar hides meanwhile."""
        return self.dragging and self.dragging['zone'] not in ('ignore', *DRAW_TOOLS)

    def redraw(self):
        self.schedule_search()
        for canvas in self.canvases:
            canvas.queue_draw()

    def schedule_search(self):
        """Look for the PDF once the selection has stopped changing for a moment."""
        if self.upscale == 1 or not self.selection or self.dragging:
            return
        if self.selection in (self.search_pending, self.search and self.search['selection']):
            return
        self.search_pending = self.selection
        if self.search_timer:
            GLib.source_remove(self.search_timer)
        self.search_timer = GLib.timeout_add(SEARCH_DELAY, self.start_search)

    def start_search(self):
        self.search_timer, self.search_pending = None, None
        if self.selection:
            self.launch_search(self.selection)
        return GLib.SOURCE_REMOVE

    def launch_search(self, selection):
        """Look for the PDF behind a selection in a separate, lower-priority process."""
        self.stop_search()
        _, png = crop(selection, self.outputs, self.pixbufs).save_to_bufferv('png', [], [])
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE)
        launcher.set_environ([f'{key}={value}' for key, value in CHILD_ENVIRONMENT.items()])
        process = launcher.spawnv([sys.executable, str(UPSCALE)])
        search = self.search = {'selection': selection, 'process': process, 'done': False, 'result': None}
        process.communicate_async(GLib.Bytes.new(png), None, self.on_search_done, search)

    def on_search_done(self, process, result, search):
        try:
            _, stdout, _ = process.communicate_finish(result)
            search['result'] = json.loads((stdout and stdout.get_data()) or b'null')
        except (GLib.Error, ValueError):
            search['result'] = None
        search['done'] = True
        if search is self.search:
            if self.waiting:
                self.loop.quit()
            self.redraw()

    def stop_search(self):
        if self.search and not self.search['done']:
            self.search['process'].force_exit()

    def source(self):
        """The PDF area under the current selection as a dict, None, or 'searching'."""
        search = self.search
        if not search or search['selection'] != self.selection or not search['done']:
            return 'searching'
        return search['result']

    def set_selection(self, selection):
        self.selection = selection
        self.redraw()

    def size_label(self):
        width, height, _ = crop_plan(self.selection, self.outputs)
        if self.upscale == 1:
            return f'{width} × {height}'
        source = self.source()
        if source == 'searching':
            return f'{width} × {height}  ·  finding the PDF…'
        if source is None:
            return f'{width} × {height}  ·  no PDF match in Okular, saving at 1×'
        label = f'{Path(source["path"]).name} p. {source["page"] + 1}'
        return f'{width * self.upscale} × {height * self.upscale}  ·  {self.upscale}× from {label}'

    def icon(self, name):
        if name not in self.icons:
            theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            self.icons[name] = theme.lookup_icon(name, None, 16, 2, Gtk.TextDirection.NONE, 0)
        return self.icons[name]

    def finish(self, action):
        # Ignore confirmation without a selection or with one in a gap between monitors.
        if action and not (self.selection and crop_plan(self.selection, self.outputs)[2]):
            return
        self.action = action
        for window in self.windows:
            window.set_visible(False)
        if self.search_timer:
            GLib.source_remove(self.search_timer)
            self.search_timer = None
        if action and self.upscale > 1 and self.source() == 'searching':
            if not self.search or self.search['selection'] != self.selection:
                self.launch_search(self.selection)
            # on_search_done ends the loop; the timeout keeps a stuck search from holding the capture.
            self.waiting = True
            GLib.timeout_add_seconds(SEARCH_WAIT, self.loop.quit)
            return
        self.loop.quit()


class Canvas(Gtk.Widget):
    def __init__(self, session, output, texture):
        super().__init__()
        self.session, self.output, self.texture = session, output, texture
        self.set_cursor_from_name('crosshair')

        gesture = Gtk.GestureDrag(button=Gdk.BUTTON_PRIMARY)
        gesture.connect('drag-begin', self.on_drag_begin)
        gesture.connect('drag-update', self.on_drag_update)
        gesture.connect('drag-end', self.on_drag_end)
        self.add_controller(gesture)

        click = Gtk.GestureClick(button=0)
        click.connect('pressed', self.on_click)
        self.add_controller(click)

        motion = Gtk.EventControllerMotion()
        motion.connect('enter', self.on_motion)
        motion.connect('motion', self.on_motion)
        self.add_controller(motion)

        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL
                                           | Gtk.EventControllerScrollFlags.DISCRETE)
        scroll.connect('scroll', self.on_scroll)
        self.add_controller(scroll)

    def global_point(self, x, y):
        return self.output.rect.x + x, self.output.rect.y + y

    def on_motion(self, _controller, x, y):
        session = self.session
        session.pointer_output = self.output
        session.pointer = point = self.global_point(x, y)
        if session.toolbar_item_at(*point):
            cursor = 'pointer'
        elif session.tool in SIZED_TOOLS and session.selection:
            cursor = 'none'  # The size outline replaces the pointer.
        elif session.drawing() or session.tool == 'pick':
            cursor = 'crosshair'
        elif session.dragging:
            return
        else:
            cursor = CURSORS[hit_test(session.selection, *point)]
        self.set_cursor_from_name(cursor)
        if session.selection:
            session.redraw()  # Toolbar hover, size outline, and color preview follow the pointer.

    def on_drag_begin(self, _gesture, x, y):
        self.session.begin_drag(*self.global_point(x, y))

    def on_drag_update(self, gesture, dx, dy):
        state = gesture.get_current_event_state()
        self.session.update_drag(dx, dy, bool(state & Gdk.ModifierType.CONTROL_MASK),
                                 bool(state & Gdk.ModifierType.SHIFT_MASK))

    def on_drag_end(self, _gesture, _dx, _dy):
        self.session.end_drag()

    def on_click(self, gesture, presses, x, y):
        session = self.session
        point = self.global_point(x, y)
        if session.toolbar_item_at(*point) or session.tool != 'select':
            return
        button = gesture.get_current_button()
        if button == Gdk.BUTTON_SECONDARY:
            session.set_selection(None)
        elif (button == Gdk.BUTTON_PRIMARY and presses == 2 and session.selection
              and session.selection.contains(*point)):
            session.finish('share')

    def on_scroll(self, _controller, _dx, dy):
        session = self.session
        if session.tool not in SIZED_TOOLS:
            return False
        session.resize_stroke(1.15 if dy < 0 else 1 / 1.15)
        return True

    def on_key(self, _controller, keyval, _keycode, state):
        session = self.session
        control = bool(state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if keyval == Gdk.KEY_Escape:
            session.finish(None)
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            session.finish('share')
        elif control and keyval in (Gdk.KEY_c, Gdk.KEY_C):
            session.finish('copy')
        elif control and keyval in (Gdk.KEY_a, Gdk.KEY_A):
            session.set_selection(session.pointer_output.rect)
        elif control and keyval in (Gdk.KEY_z, Gdk.KEY_Z):
            session.undo()
        elif keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R):
            self.on_control(True)
        elif keyval in (Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
            return self.on_shift(True)
        elif keyval in ARROWS and session.selection:
            dx, dy = ARROWS[keyval]
            step = 10 if control else 1
            session.set_selection(nudge(session.selection, dx * step, dy * step, shift, session.bounds))
        elif control:
            return False
        elif keyval in (Gdk.KEY_u, Gdk.KEY_U):
            session.activate(('upscale',))
        elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
            session.activate(('remove-white',))
        elif Gdk.keyval_to_lower(keyval) in TOOL_KEYS:
            session.set_tool(TOOL_KEYS[Gdk.keyval_to_lower(keyval)])
        elif Gdk.KEY_1 <= keyval < Gdk.KEY_1 + len(COLORS) + 1:
            session.activate(('color', keyval - Gdk.KEY_1))
        elif Gdk.keyval_to_lower(keyval) in SIZE_KEYS:
            session.resize_stroke(SIZE_KEYS[Gdk.keyval_to_lower(keyval)])
        else:
            return False
        return True

    def on_key_released(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R):
            self.on_control(False)
        elif keyval in (Gdk.KEY_Shift_L, Gdk.KEY_Shift_R):
            self.on_shift(False)

    def on_control(self, held):
        """Pressing or releasing Ctrl mid-drag switches centered resizing at once."""
        drag_state = self.session.dragging
        if drag_state and drag_state['zone'] not in ('ignore', 'brush', 'arrow', 'move'):
            self.session.update_drag(drag_state['dx'], drag_state['dy'], held)

    def on_shift(self, held):
        """Pressing or releasing Shift mid-drag snaps or frees the arrow at once."""
        drag_state = self.session.dragging
        if not (drag_state and drag_state['zone'] == 'arrow'):
            return False
        self.session.update_drag(drag_state['dx'], drag_state['dy'], False, held)
        return True

    def do_snapshot(self, snapshot):
        session, area = self.session, self.output.rect
        # Draw in global coordinates; the widget clips to its own output.
        snapshot.translate(Graphene.Point().init(-area.x, -area.y))
        snapshot.append_scaled_texture(self.texture, Gsk.ScalingFilter.NEAREST,
                                       rect(area.x, area.y, area.w, area.h))
        for annotation in [*session.annotations, *filter(None, [session.current])]:
            self.draw_annotation(snapshot, annotation)
        selection = session.selection
        visible = selection and selection.intersect(area)
        if not visible:
            snapshot.append_color(DIM, rect(area.x, area.y, area.w, area.h))
        else:
            for part in (Rect.span(area.x, area.y, area.right, visible.y),
                         Rect.span(area.x, visible.bottom, area.right, area.bottom),
                         Rect.span(area.x, visible.y, visible.x, visible.bottom),
                         Rect.span(visible.right, visible.y, area.right, visible.bottom)):
                if part.w > 0 and part.h > 0:
                    snapshot.append_color(DIM, rect(part.x, part.y, part.w, part.h))
        if selection:
            self.draw_frame(snapshot, selection, handles=session.tool == 'select')
            label = session.size_label()
            if session.remove_white:
                label += '  ·  white becomes transparent on export'
            self.draw_label(snapshot, label, selection.x, selection.y - 8, above=True)
            if not session.adjusting():
                self.draw_toolbar(snapshot)
            self.draw_tool_preview(snapshot)
        elif not session.dragging:
            layout = self.create_pango_layout(HINT)
            width, height = layout.get_pixel_size()
            self.draw_label(snapshot, HINT, area.x + (area.w - width) / 2,
                            area.y + (area.h - height) / 2, above=False)

    def draw_annotation(self, snapshot, annotation):
        if isinstance(annotation, Box):
            r = annotation.rect
            snapshot.append_color(rgba(annotation.color), rect(r.x, r.y, r.w, r.h))
        elif isinstance(annotation, Outline):
            append_outline(snapshot, annotation, rgba(annotation.color))
        elif isinstance(annotation, Arrow):
            append_arrow(snapshot, annotation.shape, annotation.width, rgba(annotation.color))
        else:
            snapshot.append_stroke(stroke_path(annotation.points), round_stroke(annotation.width),
                                   rgba(annotation.color))

    def draw_toolbar(self, snapshot):
        session = self.session
        items = session.toolbar()
        hovered = session.pointer and session.toolbar_item_at(*session.pointer)
        _, box = items[0]
        bounds = rect(box.x, box.y, box.w, box.h)
        push_rounded(snapshot, bounds, 10)
        snapshot.append_color(LABEL_BACKGROUND, bounds)
        snapshot.pop()
        tooltip = None
        for item, area in items[1:]:
            bounds = rect(area.x, area.y, area.w, area.h)
            active = (item == ('tool', session.tool)
                      or (item[0] == 'color' and item[1] == session.color_index and session.tool != 'select'))
            if item[0] == 'upscale':
                active = session.upscale > 1
            elif item[0] == 'remove-white':
                active = session.remove_white
            if item[0] != 'color' and (active or item == hovered):
                push_rounded(snapshot, bounds, 7)
                snapshot.append_color(ACTIVE_BUTTON if active else HOVER_BUTTON, bounds)
                snapshot.pop()
            if item[0] == 'upscale':
                layout = self.create_pango_layout(f'{session.upscale}×')
                text_w, text_h = layout.get_pixel_size()
                snapshot.save()
                snapshot.translate(Graphene.Point().init(area.x + (area.w - text_w) / 2,
                                                         area.y + (area.h - text_h) / 2))
                color = LABEL_TEXT if active else Gdk.RGBA(red=1, green=1, blue=1, alpha=.45)
                snapshot.append_layout(layout, color)
                snapshot.restore()
            elif item[0] == 'color':
                center_x, center_y = area.x + area.w / 2, area.y + area.h / 2
                ring = 24 if active else 20 if item == hovered else 18
                self.dot(snapshot, ACCENT if active else SWATCH_RING, center_x - ring / 2, center_y - ring / 2, ring)
                self.dot(snapshot, rgba((*COLORS, session.picked)[item[1]]), center_x - 8, center_y - 8, 16)
            elif item == ('tool', 'arrow'):
                append_arrow(snapshot, arrow_shape((area.x + 10, area.y + 22), (area.x + 22, area.y + 10), 2, head=7),
                             2, WHITE)
            elif item == ('tool', 'outline'):
                append_outline(snapshot, Outline(Rect(area.x + 10, area.y + 11, 12, 10), 2, None), WHITE)
            else:
                if item[0] == 'remove-white':
                    name = 'edit-clear-symbolic'
                else:
                    name = 'edit-undo-symbolic' if item[0] == 'undo' else ICONS[item[1]]
                faded = item[0] == 'undo' and not session.annotations
                snapshot.save()
                snapshot.translate(Graphene.Point().init(area.x + 8, area.y + 8))
                if faded:
                    snapshot.push_opacity(.35)
                session.icon(name).snapshot_symbolic(snapshot, 16, 16, [WHITE, WHITE, WHITE, WHITE])
                if faded:
                    snapshot.pop()
                snapshot.restore()
            if item == hovered:
                tooltip = (item, area)
        if tooltip:
            item, area = tooltip
            text = {'tool': lambda: next(tip for tool, _, tip in TOOLS if tool == item[1]),
                    'color': lambda: f'{COLOR_NAMES[item[1]]}  {item[1] + 1}',
                    'undo': lambda: 'Undo  Ctrl+Z',
                    'upscale': lambda: 'Sharper from the PDF open in Okular: 1×, 2×, 4×  U',
                    'remove-white': lambda: 'Remove pure white background  T  ·  '
                                           + ('On' if session.remove_white else 'Off')}[item[0]]()
            self.draw_label(snapshot, text, area.x, box.bottom + 6, above=False)

    def draw_tool_preview(self, snapshot):
        session = self.session
        if not session.pointer or session.dragging and session.dragging['zone'] == 'ignore':
            return
        x, y = session.pointer
        if session.toolbar_item_at(x, y):
            return
        if session.tool in SIZED_TOOLS:
            if session.dragging and session.dragging['zone'] in ('arrow', 'outline'):
                return  # The shape itself shows the size while drawing.
            size = session.widths[session.tool]
            builder = Gsk.PathBuilder.new()
            builder.add_circle(Graphene.Point().init(x, y), max(size / 2, 2))
            circle = builder.to_path()
            snapshot.append_stroke(circle, Gsk.Stroke.new(3), BLACK)
            snapshot.append_stroke(circle, Gsk.Stroke.new(1.5), WHITE)
        elif session.tool == 'pick':
            color = session.pixel_at(x, y)
            if color:
                self.dot(snapshot, WHITE, x + 12, y + 12, 30)
                self.dot(snapshot, rgba(color), x + 15, y + 15, 24)

    def draw_frame(self, snapshot, selection, handles):
        s = selection
        # The border sits outside the selection so it never hides selected pixels.
        for x, y, w, h in ((s.x - BORDER, s.y - BORDER, s.w + 2 * BORDER, BORDER),
                           (s.x - BORDER, s.bottom, s.w + 2 * BORDER, BORDER),
                           (s.x - BORDER, s.y, BORDER, s.h),
                           (s.right, s.y, BORDER, s.h)):
            snapshot.append_color(ACCENT, rect(x, y, w, h))
        if not handles:
            return
        middle_x, middle_y = s.x + s.w / 2, s.y + s.h / 2
        for x, y in ((s.x, s.y), (middle_x, s.y), (s.right, s.y), (s.right, middle_y),
                     (s.right, s.bottom), (middle_x, s.bottom), (s.x, s.bottom), (s.x, middle_y)):
            outer = HANDLE_SIZE + 2
            self.dot(snapshot, ACCENT, x - outer / 2, y - outer / 2, outer)
            self.dot(snapshot, HANDLE, x - HANDLE_SIZE / 2, y - HANDLE_SIZE / 2, HANDLE_SIZE)

    @staticmethod
    def dot(snapshot, color, x, y, size):
        bounds = rect(x, y, size, size)
        push_rounded(snapshot, bounds, size / 2)
        snapshot.append_color(color, bounds)
        snapshot.pop()

    def draw_label(self, snapshot, text, x, y, above):
        layout = self.create_pango_layout(text)
        width, height = layout.get_pixel_size()
        padding_x, padding_y = 8, 4
        box_w, box_h = width + 2 * padding_x, height + 2 * padding_y
        if above:
            y -= box_h
            if y < self.session.bounds.y:  # No room above: tuck it inside the selection.
                y = self.session.selection.y + 8
                x += 8
        bounds = rect(x, y, box_w, box_h)
        push_rounded(snapshot, bounds, 6)
        snapshot.append_color(LABEL_BACKGROUND, bounds)
        snapshot.pop()
        snapshot.save()
        snapshot.translate(Graphene.Point().init(x + padding_x, y + padding_y))
        snapshot.append_layout(layout, LABEL_TEXT)
        snapshot.restore()


ARROWS = {Gdk.KEY_Left: (-1, 0), Gdk.KEY_Right: (1, 0), Gdk.KEY_Up: (0, -1), Gdk.KEY_Down: (0, 1)}


def open_window(session, monitor, output, texture):
    window = Gtk.Window(decorated=False)
    LayerShell.init_for_window(window)
    LayerShell.set_namespace(window, 'shoot-select')
    LayerShell.set_layer(window, LayerShell.Layer.OVERLAY)
    LayerShell.set_monitor(window, monitor)
    for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
        LayerShell.set_anchor(window, edge, True)
    LayerShell.set_exclusive_zone(window, -1)  # Cover panels too.
    LayerShell.set_keyboard_mode(window, LayerShell.KeyboardMode.EXCLUSIVE)
    canvas = Canvas(session, output, texture)
    window.set_child(canvas)
    keys = Gtk.EventControllerKey()
    keys.connect('key-pressed', canvas.on_key)
    keys.connect('key-released', canvas.on_key_released)
    window.add_controller(keys)
    window.connect('close-request', lambda _window: session.finish(None) or True)
    session.canvases.append(canvas)
    session.windows.append(window)
    window.present()


def parse_rect(text):
    try:
        x, y, w, h = (float(part) for part in text.split(','))
    except ValueError:
        raise argparse.ArgumentTypeError('expected X,Y,WIDTH,HEIGHT') from None
    return Rect(x, y, w, h)


LAST_SELECTION = (Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state'))
                  / 'shoot-select' / 'last-selection.json')


def load_last_selection():
    try:
        x, y, w, h = json.loads(LAST_SELECTION.read_text())
        return Rect(float(x), float(y), float(w), float(h))
    except (OSError, ValueError, TypeError):
        return None


def remember_selection(selection):
    """Keep the selection for the next run; losing it is never worth failing a capture."""
    try:
        LAST_SELECTION.parent.mkdir(parents=True, exist_ok=True)
        temporary = LAST_SELECTION.with_suffix('.tmp')
        temporary.write_text(json.dumps([selection.x, selection.y, selection.w, selection.h]))
        temporary.replace(LAST_SELECTION)
    except OSError as error:
        print(f'shoot-select: cannot remember the selection: {error}', file=sys.stderr)


def save(data, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f'.{path.name}.tmp')
    temporary.write_bytes(data)
    temporary.replace(path)


def copy_to_clipboard(data):
    # wl-copy keeps serving the clipboard in the background; it must not hold
    # our stdout open, or callers reading it would wait until the next copy.
    subprocess.run(['wl-copy', '--type', 'image/png'], input=data, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, env=CHILD_ENVIRONMENT, timeout=5, check=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--output', type=Path, help='where Enter saves the PNG (default: clipboard only)')
    parser.add_argument('--initial', type=parse_rect, metavar='X,Y,W,H',
                        help='start with this selection, in logical global coordinates '
                             '(default: the last saved or copied one)')
    args = parser.parse_args()

    if not Gtk.init_check():
        raise RuntimeError('Cannot open the Wayland display')
    if not LayerShell.is_supported():
        raise RuntimeError('The compositor does not support wlr-layer-shell')
    monitor_list = Gdk.Display.get_default().get_monitors()
    monitors = [monitor_list.get_item(index) for index in range(monitor_list.get_n_items())]
    pixbufs = capture(monitors)

    outputs = []
    for monitor, pixbuf in zip(monitors, pixbufs):
        geometry = monitor.get_geometry()
        outputs.append(Output(monitor.get_connector(),
                              Rect(geometry.x, geometry.y, geometry.width, geometry.height),
                              pixbuf.get_width(), pixbuf.get_height()))
    session = Session(outputs, {output.name: pixbuf for output, pixbuf in zip(outputs, pixbufs)},
                      restore(args.initial or load_last_selection(), outputs))
    for monitor, output, pixbuf in zip(monitors, outputs, pixbufs):
        open_window(session, monitor, output, texture_for(pixbuf))
    session.loop.run()

    source = session.source() if session.upscale > 1 else None
    session.stop_search()
    if not session.action:
        return CANCELLED
    base = None
    if isinstance(source, dict):
        import upscale
        width, height, _ = crop_plan(session.selection, session.outputs)
        base = upscale.render_source(upscale.Source(**source), width, height, session.upscale)
    image = render(session.selection, session.outputs, session.pixbufs, session.annotations, base,
                   remove_white=session.remove_white)
    if session.action == 'share' and args.output:
        save(image, args.output)
    copy_to_clipboard(image)
    remember_selection(session.selection)
    print(session.action, flush=True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as error:
        print(f'shoot-select: {error}', file=sys.stderr)
        sys.exit(2)
