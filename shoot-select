#!/usr/bin/env python3
"""Freeze every screen, select a region with resizable handles, and save it as PNG.

Drag anywhere to select, on any monitor. Drag the edges or corners to resize,
drag the inside to move, or drag outside to start again. Hold Ctrl while
dragging to resize around the center. Arrow keys move the selection by one
pixel; Shift+arrows resize it; Ctrl makes steps of ten.

The toolbar under the selection annotates the capture: Box (R) covers a
rectangle, Outline (O) draws a hollow one around something, Brush (B) paints
freehand, Arrow (A) points things out (Shift snaps it to 45 degrees), and Pick
(I) takes a color from the screen so a cover can match its background. V
returns to adjusting the selection, 1-4 choose a color (arrows and outlines
start red, the rest black), Q and W (or [ ] or the scroll wheel) make the
outline, brush, or arrow thinner and thicker, and Ctrl+Z undoes.

The 2× button (U) renders the selection again from the PDF open in Okular,
at two or four times the screen resolution.
T toggles removal of pure white pixels in the saved and copied PNG.

Enter, Space, or a double-click inside saves the PNG, copies it to the
clipboard, and prints "share". Ctrl+C only copies it and prints "copy".
Escape cancels and exits with status 1.

The next run starts with the last saved or copied selection, like Niri's
screenshot UI. Drag outside it to start over, or right-click to clear it.
"""
import argparse
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from selection import (MIN_NEW_SIZE, Arrow, Box, Outline, Output, Rect, Stroke, arrow_shape, centered_span, clamp, crop_plan,
                       drag, restore, hit_test, nudge, place_toolbar, snap_angle, span_within)

LAYER_SHELL = 'libgtk4-layer-shell.so.0'
CANCELLED = 1

