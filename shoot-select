HANDLE = Gdk.RGBA(red=1, green=1, blue=1, alpha=1)
LABEL_BACKGROUND = Gdk.RGBA(red=.08, green=.08, blue=.1, alpha=.85)
LABEL_TEXT = Gdk.RGBA(red=1, green=1, blue=1, alpha=1)
BORDER = 2
HANDLE_SIZE = 9
HINT = 'Drag to select  ·  Ctrl from center  ·  Enter share  ·  Ctrl+C copy  ·  Esc cancel'
WHITE = Gdk.RGBA(red=1, green=1, blue=1, alpha=1)
BLACK = Gdk.RGBA(red=0, green=0, blue=0, alpha=1)
ACTIVE_BUTTON = Gdk.RGBA(red=.50, green=.78, blue=1, alpha=.35)
